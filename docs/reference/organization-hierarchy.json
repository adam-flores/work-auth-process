{
  "fiction": {
    "notice": "EVERY NAME, CODE, SITE AND FIGURE IN THIS FILE IS INVENTED. Calderis Aerospace does not exist. No entity name, cost-center code, CAS code, site, or disclosure classification here is copied, derived from, or decodable back to any real organization. Any resemblance to a real company is coincidental.",
    "purpose": "A synthetic stand-in for the classification chart the work authorization form's nine manual-lookup fields are read from. It exists so that 'how does a user arrive at the correct classification' can be argued against a concrete tree instead of an abstract one.",
    "ticket": "https://github.com/adam-flores/work-auth-process/issues/8"
  },
  "provenance": {
    "method": "Shape transcribed by hand from a working reference document; content invented outright.",
    "whatWasTaken": "Structural properties only: the number of charts, their differing layouts and code schemes, the depth of nesting, the shape of the code formats, which attributes are encoded visually rather than textually, and the kinds of irregularity present.",
    "whatWasNotTaken": "No real entity names, cost-center codes, CAS codes, CAGE codes, site locations, disclosure classifications, or footnote text. The source is sensitivity-labelled, is not in this repository, and never will be.",
    "sourceCharacteristics": "The source workbook holds three chart tabs whose entire content is embedded screenshots; the whole file contains five unique text strings. There is no machine-readable data in it at all."
  },
  "readMeFirst": {
    "theShapeIsThePoint": "This file is deliberately awkward. The irregularities below are reproduced on purpose, because a picker built against a clean tree would prove nothing about the real problem.",
    "format": "JSON was chosen for readability at this stage. It is NOT a persistence decision and does not touch ADR-0003 (data store: XML or SQLite), which covers authorization lifecycle state, not static reference data. Re-serializing sixty records is trivial.",
    "levels": [
      "legal entity",
      "division",
      "department"
    ],
    "levelNote": "Three levels, in this project's vocabulary: legal entity, division, department. The source chart's own three levels map onto them one for one - BDR-0004 retired the chart's vocabulary and BDR-0008 established that the three charts are the three legal entities. The form's four lookup levels were not mapped onto these three; BDR-0004 replaced the model instead.",
    "vocabularyNote": "This file was rewritten into the product's vocabulary. The 'provenance' and 'fiction' blocks are deliberately untouched: they record what was and was not taken from a sensitivity-labelled source document, and that record has to stay accurate about the source rather than about us."
  },
  "encodings": {
    "note": "In the source, several attributes are carried ONLY by formatting - never by text. A reader has to decode a colour or an icon to know the answer. Reproduced here as explicit fields so a prototype can work with them, with the original visual carrier recorded alongside.",
    "fill": [
      {
        "value": "blue-grey",
        "means": "full",
        "label": "Full cost-accounting coverage; department files its own Disclosure Statement"
      },
      {
        "value": "yellow",
        "means": "modified",
        "label": "Modified cost-accounting coverage"
      },
      {
        "value": "white",
        "means": "exempt",
        "label": "Exempt from cost-accounting coverage"
      },
      {
        "value": "tan",
        "means": "covered-by-other",
        "label": "No Disclosure Statement of its own; practices disclosed in another division's DS"
      },
      {
        "value": "grey",
        "means": null,
        "label": "Division header box, not a selectable department"
      }
    ],
    "textColour": [
      {
        "value": "black",
        "means": "domestic",
        "label": "Domestic entity"
      },
      {
        "value": "red",
